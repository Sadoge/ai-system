# Postgres (matches infra/docker/docker-compose.yml)
DATABASE_URL=postgres://ai:ai@localhost:5432/ai_system

# Provider keys — only needed once LLM-backed stages are enabled (Phase 1).
# The Phase 0 trivial pipeline runs without any key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LOG_LEVEL=info

# Where the worker keeps cached repository checkouts and run worktrees.
AI_DATA_DIR=./data

# true = deterministic mock agents + scripted coding executor (no LLM calls,
# no keys needed). Great for trying the full MVP pipeline locally.
MOCK_MODELS=false

# Coding agent CLI command; {prompt_file} is replaced with the prompt path.
# Default wraps Claude Code non-interactive mode.
#CODING_AGENT_CMD=claude -p "$(cat {prompt_file})" --output-format text
CODING_TIMEOUT_MS=900000

# Enables branch push + PR creation in the package stage for GitHub remotes.
GITHUB_TOKEN=
