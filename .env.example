# Postgres (matches infra/docker/docker-compose.yml)
DATABASE_URL=postgres://ai:ai@localhost:5432/ai_system

# Provider keys — only needed once LLM-backed stages are enabled (Phase 1).
# The Phase 0 trivial pipeline runs without any key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LOG_LEVEL=info

# Where the worker keeps cached repository checkouts and run worktrees.
AI_DATA_DIR=./data

# true = deterministic mock agents + scripted coding executor (no LLM calls,
# no keys needed). Great for trying the full MVP pipeline locally.
MOCK_MODELS=false

# Default coding agent when a repository does not set its own:
#   claude_code (default) | codex | api_loop | scripted
# Per repository: ai-system repo register ... --executor codex
# Check what is installed:  ai-system repo check-agents
CODING_EXECUTOR=claude_code
CODING_TIMEOUT_MS=900000

# Enables branch push + PR creation in the package stage for GitHub remotes.
GITHUB_TOKEN=
# Same for GitLab remotes (merge requests). GITLAB_HOST for self-managed.
GITLAB_TOKEN=
GITLAB_HOST=gitlab.com

# Control plane API (apps/api) + web UI (apps/web).
API_PORT=3001
API_URL=http://localhost:3001
# Bearer token the web UI sends to the API, server-side. This is a real API
# key minted by `ai-system org bootstrap` (or `org key-create`) — the API has
# no ambient/shared token any more: every request resolves to a principal and
# the principal's organization scopes every query.
API_TOKEN=

# Default per-organization API rate limit (overridable per org via quotas).
RATE_LIMIT_PER_MINUTE=120

# Jira read integration: `run start --jira KEY`, the jiraKey field in the UI,
# and the /api/webhooks/jira trigger. Write-back is a PR-link comment only.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Shared secret for the webhook endpoint (?secret=...). The webhook runs as a
# `member` of JIRA_WEBHOOK_ORG_ID, so it never borrows a person's rights.
JIRA_WEBHOOK_SECRET=
JIRA_WEBHOOK_ORG_ID=
# Optional: status to move the ticket to once a PR is opened, e.g. "In Review".
# Skipped silently when the project's workflow offers no such transition.
JIRA_PR_STATUS=

# Linear intake: `run start --linear ENG-123`; write-back is a PR-link comment.
LINEAR_API_KEY=

# Worker capacity for parallel coding tasks (the engine also caps per run).
TASK_CONCURRENCY=4

# Additional providers.
GOOGLE_API_KEY=
# Anything speaking the OpenAI protocol: vLLM, Ollama, LM Studio, OpenRouter.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Object storage for large artifacts. Unset = everything stays inline in
# Postgres. S3_ENDPOINT covers MinIO/R2.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_INLINE_THRESHOLD_BYTES=65536
